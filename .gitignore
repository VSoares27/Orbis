# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ─── Dependências ───────────────────────────────────────────
node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Expo / Metro ───────────────────────────────────────────
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# ─── Pastas nativas geradas (prebuild) ──────────────────────
/ios
/android
.kotlin/

# ─── Builds e EAS ───────────────────────────────────────────
*.apk
*.aab
*.ipa
*.app
eas.local.json

# ─── Chaves, certificados e segredos ────────────────────────
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
google-services.json
GoogleService-Info.plist
.env
.env.*
!.env.example

# ─── TypeScript / ESLint / testes ───────────────────────────
*.tsbuildinfo
.eslintcache
coverage/

# ─── Logs ───────────────────────────────────────────────────
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.log*

# ─── Banco SQLite local (dados de teste no dev) ─────────────
*.db
*.db-journal
*.sqlite
*.sqlite3

# ─── Editor / IDE ───────────────────────────────────────────
# Mantém só as configurações compartilhadas do VS Code.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ─── Claude Code (arquivos locais) ──────────────────────────
.claude/settings.local.json

# ─── Sistema operacional ────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── Temporários ────────────────────────────────────────────
*.orig
*.orig.*
*.tmp
*.zip